# Backend & Orchestrator
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (default). For local dev without Docker, use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./ml_train.db
DATABASE_URL=postgresql+asyncpg://ml_train:ml_train_secret@localhost:5432/ml_train

# Kubernetes (for orchestrator)
KUBE_CONFIG_PATH=~/.kube/config
# Or in-cluster: leave unset for in-cluster config

# Docker Registry (for pushing training images)
REGISTRY_URL=ghcr.io
REGISTRY_IMAGE=your-org/ml-trainer

# Training defaults
DEFAULT_TRAINER_IMAGE=ml-trainer:latest
